# ── macOS ────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# ── LaTeX auxiliary files ─────────────────────────
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.blg
*.bbl
*.bcf
*.run.xml
*.nav
*.snm
*.vrb
*.idx
*.ind
*.ilg
*.glo
*.gls
*.glg
*.xdy
*.acn
*.acr
*.alg
*.ist
*.dvi
*.xdv
**/main.pdf

# ── Lean build directory ─────────────────────────
# lake's build output and the Mathlib checkout it pulls in — several gigabytes,
# all of it reproducible from lakefile.toml, lean-toolchain and
# lake-manifest.json, which are tracked. See docs/lean-convention.md.
lean/.lake/

# ── Issue worklists (/issues) ────────────────────
# A rendering of the open GitHub issues, not the record. Regenerated, never read
# back — see docs/issue-convention.md.
issues/

# ── Audit reports (/audit) ───────────────────────
# The only untracked thing under .claude/; everything else there is committed.
.claude/audits/

# ── Python ───────────────────────────────────────
__pycache__/
*.py[cod]

# ── Editors ──────────────────────────────────────
# VSCode — settings are per-machine, but extensions.json is the one file
# meant to be shared: it is how a fresh clone learns what to install.
# Note `.vscode/*` and not `.vscode/`: git does not descend into an excluded
# directory, so a negation under one can never fire.
.vscode/*
!.vscode/extensions.json

# Vim
*.swp
*.swo

# Emacs
*~
\#*\#